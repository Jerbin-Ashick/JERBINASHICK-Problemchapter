class Solution {
    
    public int power(int n,int i){
        if(i==0){
            return 1;
        }
        return n*power(n,i-1);
    }
    
    public static void main(String[] args) {
        Solution obj = new Solution();
        int n = 3, i=4;
        System.out.println(obj.power(n,i)); 
    }
}
